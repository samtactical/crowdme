---
import Icon from "./Icon.astro";
import Eyebrow from "./ui/Eyebrow.astro";

const faqs = [
  {
    q: "Vad kostar ett första möte?",
    a: "Ingenting. Vi bokar det för att se om vi passar er — och ni oss. Ni får våra tankar om er synlighet oavsett om ni väljer att gå vidare.",
  },
  {
    q: "Vilka AI-tjänster tittar ni på?",
    a: "ChatGPT, Perplexity, Google Gemini, Microsoft Copilot, DeepSeek och Googles AI-svar i sökresultatet. Vilka som är mest relevanta beror på er bransch och era köpare.",
  },
  {
    q: "Behöver vi byta webbplats?",
    a: "Nästan aldrig. Det mesta av arbetet görs på den sajt ni redan har, med det innehåll ni redan har. Om plattformen står i vägen säger vi det rakt ut.",
  },
  {
    q: "Hur skiljer sig det här från vår nuvarande SEO-byrå?",
    a: "Det ersätter inte SEO — det ligger bredvid. Vi jobbar gärna mot er befintliga byrå och lämnar åtgärderna i en form de kan genomföra.",
  },
  {
    q: "Hur lång tid tar det innan något händer?",
    a: "Det varierar med hur ofta modellerna uppdaterar sitt underlag och hur er sajt ser ut idag. Vi lovar inga datum — vi mäter utgångsläget först och följer upp mot det.",
  },
  {
    q: "Vad gör ni med våra uppgifter?",
    a: "Vi använder dem bara för att boka och förbereda mötet, och för att kontakta er om det. Inga uppgifter säljs vidare, och ni kan när som helst be oss radera dem.",
  },
];
---

<section id="fragor" class="border-b border-line">
  <div class="mx-auto grid max-w-page gap-10 px-4 py-20 sm:px-6 md:py-28 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
    <div data-reveal-group>
      <Eyebrow data-reveal>Vanliga frågor</Eyebrow>
      <h2 class="display-2 mt-8" data-reveal>Det ni brukar undra.</h2>
      <p class="mt-6 max-w-xs text-sm leading-relaxed text-ink-soft" data-reveal>
        Hittar ni inte svaret här tar vi det gärna på mötet — ni
        bestämmer er efteråt.
      </p>
    </div>

    <div class="divide-y divide-line-strong border-y border-line-strong" data-reveal-group>
      {
        faqs.map((f) => (
          <details data-reveal class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-base font-medium transition-colors marker:hidden hover:text-ink-soft">
              {f.q}
              <span
                aria-hidden="true"
                class="grid h-6 w-6 shrink-0 place-items-center rounded-sm bg-paper-card text-ink-soft transition-transform duration-300 ease-out group-open:rotate-45"
              >
                <Icon name="plus" weight="bold" class="h-3 w-3" />
              </span>
            </summary>
            <p class="max-w-2xl pb-6 text-sm leading-relaxed text-ink-soft">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
