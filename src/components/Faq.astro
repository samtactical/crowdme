---
import Icon from "./Icon.astro";
import Eyebrow from "./ui/Eyebrow.astro";

import { TIERS } from "../lib/pricing";
import { AI_SURFACE_ORDER, AI_SURFACES } from "../lib/brandIcons";

/**
 * Svaren är skrivna för att kunna citeras var för sig av en AI: första
 * meningen svarar på frågan, resten ger fakta. Ingen mening får luta sig
 * mot en annan fråga ("som ovan"), och inga superlativ.
 *
 * De tre första frågorna definierar begreppen, eftersom det är de
 * sökningarna ("vad är GEO") som både Google och AI-tjänsterna besvarar
 * med ett utdrag. Samma lista blir FAQPage-data längst ned.
 *
 * Tjänstelistan och priserna läses ur lib/ — skriv aldrig in dem för hand.
 */
const surfaceNames = AI_SURFACE_ORDER.map((n) => AI_SURFACES[n].label);
const surfaceList = `${surfaceNames.slice(0, -1).join(", ")} och ${surfaceNames.at(-1)}`;

const price = (id: string) => TIERS.find((t) => t.id === id)!;
const audit = price("audit");
const foundation = price("foundation");
const growth = price("growth");
const enterprise = price("enterprise");

const faqs = [
  {
    q: "Vad är AI SEO?",
    a: `AI SEO, eller AI Search Optimization, är arbetet med att göra ett företag synligt och citerat i AI-genererade svar. Det gäller bland annat ${surfaceList}, men även andra AI-tjänster. Målet är att AI-tjänsten nämner företaget, beskriver det korrekt och hänvisar till rätt källor. Det är det arbetet Crowdme gör.`,
  },
  {
    q: "Vad är GEO (Generative Engine Optimization)?",
    a: "GEO står för Generative Engine Optimization: optimering för tjänster som svarar med genererad text i stället för en lista med länkar. Det gäller AI-sökningar som ChatGPT Search, Perplexity och Google AI Mode, och AI-webbläsare som Perplexitys Comet och OpenAIs ChatGPT Atlas. Begreppen GEO, AI SEO och AI Search Optimization används ofta om samma arbete.",
  },
  {
    q: "Vad är skillnaden mellan SEO och AI SEO?",
    a: "Klassisk SEO optimerar för placeringar och klick i Googles resultatlista, och är fortfarande viktigt. AI SEO optimerar för att bli nämnd och citerad i AI-tjänsternas svar. Grunden överlappar — teknik, struktur och innehåll — men AI SEO lägger till entitetsoptimering, citerbara faktapåståenden, externa omnämnanden och mätning av AI-synlighet. Crowdme arbetar med båda.",
  },
  {
    q: "Hur syns man i ChatGPT och Google AI Overviews?",
    a: "AI-tjänster nämner företag som de kan beskriva med säkerhet. Det kräver tydliga fakta på den egna webbplatsen, strukturerad data, att AI-crawlare kan läsa sajten och att andra källor bekräftar samma uppgifter. Det är de fyra områden Crowdme arbetar med.",
  },
  {
    q: "Vilka AI-tjänster mäter ni synlighet i?",
    a: `Vi mäter synlighet i ${surfaceList}. Vilka som väger tyngst beror på er bransch, och vi lägger tiden där era köpare faktiskt frågar.`,
  },
  {
    q: "Vilka företag arbetar Crowdme med?",
    a: "Crowdme arbetar med svenska små och medelstora företag, och med större organisationer genom ett skräddarsytt upplägg. Vi finns i Stockholm och tar uppdrag i hela Sverige.",
  },
  {
    q: "Vad kostar AI SEO?",
    a: `${audit.name} kostar ${audit.price} kr som engångsuppdrag. Löpande AI SEO kostar ${foundation.price.toLowerCase()} ${foundation.unit} med ${foundation.name} och ${growth.price.toLowerCase()} ${growth.unit} med ${growth.name}. ${enterprise.name} kostar ${enterprise.price.toLowerCase()} kr/mån och offereras efter behov. Alla priser är vägledande och exklusive moms.`,
  },
  {
    q: "Vad kostar ett första möte?",
    a: "Ingenting. På mötet lär vi känna ert företag och vad ni vill uppnå, och berättar hur vi kan hjälpa er att synas i AI-svar. Ni bestämmer själva om ni vill gå vidare.",
  },
  {
    q: "Kan ni garantera att vi syns i AI?",
    a: "Ingen kan garantera exakt vad en AI-tjänst svarar, och den som lovar det lovar för mycket. Det vi kan lova är ett tydligt arbetssätt: vi mäter var ni står, åtgärdar det som påverkar synligheten och visar varje månad hur ni ligger till jämfört med konkurrenterna.",
  },
  {
    q: "Hur lång tid tar det innan något händer?",
    a: "Tekniska hinder och otydliga sidor kan åtgärdas direkt. AI-tjänster som söker på webben, som ChatGPT Search och Perplexity, läser webben löpande och kan plocka upp förändringar snabbt. Modellernas inbyggda kunskap uppdateras mer sällan. Därför mäter vi ert utgångsläge först och visar utvecklingen varje månad.",
  },
  {
    q: "Behöver vi byta webbplats?",
    a: "Nej. Arbetet görs på den webbplats ni redan har, med det innehåll ni redan har. Vi fyller på och justerar det som behövs.",
  },
  {
    q: "Hur skiljer sig det här från vår nuvarande SEO-byrå?",
    a: "AI SEO ersätter inte SEO — det ligger bredvid. Vi arbetar gärna tillsammans med er befintliga byrå och lämnar åtgärderna i en form de kan genomföra. Vill ni samla allt på ett ställe gör Crowdme både klassisk SEO och AI SEO.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section id="fragor" class="border-b border-line">
  <div class="mx-auto grid max-w-page gap-10 px-4 py-20 sm:px-6 md:py-28 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
    <div data-reveal-group>
      <Eyebrow data-reveal>Vanliga frågor</Eyebrow>
      <h2 class="display-2 mt-8" data-reveal>Frågor om AI SEO, GEO och Crowdme.</h2>
      <p class="mt-6 max-w-xs text-sm leading-relaxed text-ink-soft" data-reveal>
        Hittar ni inte svaret här tar vi det gärna på mötet, eller mejla oss
        på <a href="mailto:hej@crowdme.se" class="text-ink underline decoration-line-strong underline-offset-4 transition-colors hover:decoration-ink">hej@crowdme.se</a>.
      </p>
    </div>

    <div class="divide-y divide-line-strong border-y border-line-strong" data-reveal-group>
      {
        faqs.map((f) => (
          <details data-reveal class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-base font-medium transition-colors marker:hidden hover:text-ink-soft">
              {f.q}
              <span
                aria-hidden="true"
                class="grid h-6 w-6 shrink-0 place-items-center rounded-sm bg-paper-card text-ink-soft transition-transform duration-300 ease-out group-open:rotate-45"
              >
                <Icon name="plus" weight="bold" class="h-3 w-3" />
              </span>
            </summary>
            <p class="max-w-2xl pb-6 text-sm leading-relaxed text-ink-soft">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
