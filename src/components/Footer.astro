---
const year = new Date().getFullYear();

const columns = [
  {
    heading: "Sidan",
    links: [
      { href: "/#problemet", label: "Problemet" },
      { href: "/#ai-sokningen", label: "AI-sökningen" },
      { href: "/#analysen", label: "Så arbetar vi" },
      { href: "/#priser", label: "Priser" },
      { href: "/om-oss", label: "Om oss" },
    ],
  },
  {
    heading: "Kom igång",
    links: [
      { href: "/boka", label: "Boka möte" },
      { href: "/#fragor", label: "Vanliga frågor" },
      { href: "mailto:hej@crowdme.se", label: "hej@crowdme.se" },
    ],
  },
  {
    heading: "Juridik",
    links: [{ href: "/integritetspolicy", label: "Integritetspolicy" }],
  },
];
---

<footer class="border-t border-line bg-paper">
  <div class="mx-auto max-w-page px-4 py-16 sm:px-6 md:py-20">
    <div class="grid gap-10 md:grid-cols-[1.4fr_repeat(3,1fr)] md:gap-8">
      <div class="max-w-xs">
        <img
          src="/logo/crowdme-logomark-dark-green.webp"
          alt="Crowdme"
          width="2650"
          height="516"
          class="h-6 w-auto"
        />
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">
          Crowdme är en AI SEO-byrå i Stockholm. Vi hjälper svenska
          företag att synas i ChatGPT, Google AI Overviews och andra
          AI-svar.
        </p>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.heading}>
            <p class="eyebrow">{column.heading}</p>
            <ul class="mt-4 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-ink-soft transition-colors hover:text-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-line pt-6 text-[12px] text-ink-soft sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Crowdme</p>
    </div>
  </div>
</footer>
