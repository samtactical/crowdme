---
const year = new Date().getFullYear();
---

<footer class="bg-paper-invert text-ink-invert">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-col gap-10 border-b border-ink-invert/20 pb-10 md:flex-row md:items-end md:justify-between">
      <div class="max-w-md">
        <p class="text-xl font-bold tracking-tight">Crowdme<span class="text-accent">.</span></p>
        <p class="mt-4 leading-relaxed text-ink-invert/70">
          Vi hjälper svenska B2B-företag att synas när kunderna frågar AI istället
          för att googla.
        </p>
      </div>
      <a
        href="#analys"
        class="inline-flex w-fit items-center justify-center bg-ink-invert px-6 py-3.5 font-semibold text-ink transition-opacity hover:opacity-90"
      >
        Få gratis analys
      </a>
    </div>

    <div class="mt-8 flex flex-col gap-4 text-sm text-ink-invert/60 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Crowdme</p>
      <nav aria-label="Sidfotsmeny" class="flex gap-6">
        <a class="transition-colors hover:text-ink-invert" href="/integritetspolicy">
          Integritetspolicy
        </a>
        <a class="transition-colors hover:text-ink-invert" href="mailto:hej@crowdme.se">
          hej@crowdme.se
        </a>
      </nav>
    </div>
  </div>
</footer>
