---
const nav = [
  { href: "#problemet", label: "Problemet" },
  { href: "#ai-sokningen", label: "AI-sökningen" },
  { href: "#analysen", label: "Analysen" },
  { href: "#sa-gar-det-till", label: "Så går det till" },
];
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300 [&[data-scrolled]]:border-line [&[data-scrolled]]:bg-paper/85 [&[data-scrolled]]:backdrop-blur-md"
>
  <div class="mx-auto flex max-w-page items-center justify-between gap-6 px-4 py-4 sm:px-6">
    <a href="/" class="shrink-0" aria-label="Crowdme, till startsidan">
      <img
        src="/logo/crowdme-logomark-dark-green.webp"
        alt="Crowdme"
        width="2650"
        height="516"
        class="h-[18px] w-auto sm:h-5"
      />
    </a>

    <nav aria-label="Huvudmeny" class="hidden items-center gap-7 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm text-ink-soft transition-colors hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <a
        href="#fragor"
        class="hidden rounded-md border border-line-strong px-5 py-2 text-sm font-medium text-ink-soft transition-colors hover:bg-paper-alt hover:text-ink sm:inline-flex"
      >
        Vanliga frågor
      </a>
      <a
        href="#boka"
        class="inline-flex items-center rounded-md bg-solid px-5 py-2 text-sm font-medium text-ink-invert transition-colors hover:bg-solid-hover"
      >
        Boka möte
      </a>
    </div>
  </div>
</header>
