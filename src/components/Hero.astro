---
import Globe from "./ui/Globe.astro";
import Eyebrow from "./ui/Eyebrow.astro";
import BrandIcon from "./ui/BrandIcon.astro";
import {
  AI_SURFACE_ORDER,
  AI_SURFACES,
  surfaceLabel,
  type AiSurface,
} from "../lib/brandIcons";

/**
 * Illustration, inte mätning: exempel på hur svenska köpare formulerar
 * sig när de frågar en AI istället för att googla. Städerna är riktiga,
 * frågorna är påhittade exempel — panelen är märkt därefter.
 */
const searches = [
  { id: "sthlm", location: [59.3293, 18.0686] as [number, number], label: "bästa elektriker Stockholm" },
  { id: "gbg", location: [57.7089, 11.9746] as [number, number], label: "Städfirma Göteborg avtal" },
  { id: "malmo", location: [55.605, 13.0038] as [number, number], label: "redovisningsbyrå Malmö" },
  { id: "uppsala", location: [59.8586, 17.6389] as [number, number], label: "IT-support Uppsala småbolag" },
  { id: "linkoping", location: [58.4109, 15.6216] as [number, number], label: "rekryteringsföretag Linköping" },
  { id: "umea", location: [63.8258, 20.263] as [number, number], label: "takläggare Umeå omdömen" },
  { id: "lulea", location: [65.5848, 22.1547] as [number, number], label: "industriservice Luleå" },
];

/**
 * AI-ytorna under knapparna. Raden säger vad vi mäter i — inte vem vi
 * samarbetar med och inte vilka som är kunder. Håll rubriken över raden
 * explicit; utan den blir tio logotyper en logotypvägg, och sådana är
 * förbjudna (AGENTS.md).
 */
const surfaces = AI_SURFACE_ORDER;

/**
 * Rubriken roterar genom exakt samma lista, i samma ordning, som
 * raden under den. Det är därför den tända logotypen vandrar snyggt
 * från vänster till höger — och det gör att de två inte kan glida
 * isär. Lägg inte en egen ordning här.
 *
 * I raden bär märket avsändaren, så där räcker "AI Overviews". I
 * rubriken finns inget märke, och då måste hela namnet stå ut.
 */
const rotation: AiSurface[] = AI_SURFACE_ORDER;
const names = rotation.map((name) => AI_SURFACES[name].label);

/** Det skärmläsare och sökmotorer får i stället för det roterande
 *  ordet: hela listan, med svenskt "och" före det sista namnet. */
const srList = `${names.slice(0, -1).join(", ")} och ${names.at(-1)}`;

---

<section data-hero class="border-b border-line">
  <div
    class="mx-auto max-w-page px-4 pt-28 sm:px-6 md:pt-36"
    data-reveal-group
  >
    <div class="text-center" data-reveal>
      <Eyebrow align="center" rule={false}>AI-synlighet för svensk B2B</Eyebrow>

      <h1 class="display-1 mt-5 text-balance">
        <span class="block">Bli företaget som syns i</span>

        {/* Orden är aria-hidden och hela listan ligger i klartext
            efter dem — annars läser en skärmläsare upp en rubrik
            som byter innehåll under fötterna på den. */}
        <span class="rotator mt-1.5" data-rotator aria-hidden="true">
          {rotation.map((name, i) => (
            <span
              class="rotator__word"
              data-word={name}
              data-active={i === 0 ? "" : undefined}
            >
              {AI_SURFACES[name].label}
            </span>
          ))}
        </span>

        <span class="sr-only">{srList}.</span>
      </h1>

      <p class="mx-auto mt-6 max-w-[34rem] text-lg leading-relaxed text-ink-soft">
        Era köpare frågar ChatGPT innan de googlar. Där finns inga tio blå
        länkar — bara ett svar, med ett fåtal namn i.
      </p>

      <div class="mt-9 flex flex-col items-center justify-center gap-2 sm:flex-row">
        <a
          href="/boka"
          class="inline-flex w-full items-center justify-center rounded-md bg-solid px-5 py-3 text-sm font-medium text-ink-invert transition-colors hover:bg-solid-hover sm:w-auto"
        >
          Boka ett möte
        </a>
        <a
          href="#analysen"
          class="inline-flex w-full items-center justify-center rounded-md border border-line-strong px-5 py-3 text-sm font-medium text-ink-soft transition-colors hover:bg-paper-alt hover:text-ink sm:w-auto"
        >
          Vad vi tittar på
        </a>
      </div>

      <div class="mt-10 flex flex-col items-center md:mt-12">
        <p class="sr-only">Ytorna vi mäter er synlighet i</p>
        <ul class="flex w-full max-w-[34rem] flex-wrap items-center justify-center gap-x-2.5 gap-y-1.5 sm:gap-x-3">
          {
            surfaces.map((name) => (
              <li class="surface" data-surface={name}>
                <BrandIcon
                  name={name}
                  decorative
                  class="h-[1.05rem] w-[1.05rem] shrink-0"
                />
                {surfaceLabel(name, "short")}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Ingen platta och ingen ram: klotet ligger direkt på pappret
         och skärs av mot frågebandet. Etiketten ligger kvar i
         markupen som figcaption, men syns inte. -->
    <figure class="mt-14 px-4 sm:px-6 md:mt-20" data-reveal>
      <figcaption class="sr-only">
        Illustration: exempel på hur svenska köpare formulerar sig när de
        frågar en AI. Frågorna är påhittade exempel, inte uppmätt trafik.
      </figcaption>
      {/* Inzoomat på Norden.

          scale beskär klotet i sidled — sfären blir bredare än
          canvasen och kanterna går raka. Vid 1.25 syns kupolen
          fortfarande upptill; vid 1.4 är silhuetten i praktiken en
          rektangel och hela klotkänslan är borta. Gå inte högre.

          mapSamples följer med uppåt: samma antal punkter utspridda
          över en större yta tunnar ut kustlinjerna tills Skandinavien
          inte går att känna igen.

          sway är nedskruvad så att vaggningen håller sig kring Norden
          i stället för att svepa dit där kanten är beskuren. */}
      <Globe
        markers={searches}
        phi={4.05}
        theta={0.86}
        sway={0.22}
        scale={1.25}
        reveal={0.58}
        mapSamples={32000}
        markerSize={0.02}
        dark={0}
        mapBrightness={2.2}
        diffuse={0.5}
      />
    </figure>
  </div>

</section>

<script>
  /**
   * Roterande ord i rubriken, plus tändningen av motsvarande logotyp
   * i raden under.
   *
   * Kostnaden är medvetet nära noll: orden ligger redan i markupen,
   * och varje varv byter bara ett attribut. Övergången animerar
   * opacity, translate och blur — allt tre kompositoregenskaper, så
   * ingen layout räknas om. Rotationen pausas när fliken är dold
   * eller rubriken har rullat ur bild; en osynlig animation ska inte
   * hålla igång en timer.
   *
   * prefers-reduced-motion stänger av bytet helt. Rubriken står då
   * kvar på det första ordet, vilket är en fullständig mening — och
   * hela listan finns ändå i den sr-only-text som ligger efter.
   */
  const rotator = document.querySelector<HTMLElement>("[data-rotator]");

  if (rotator) {
    const words = Array.from(
      rotator.querySelectorAll<HTMLElement>(".rotator__word"),
    );
    const lamps = new Map(
      Array.from(document.querySelectorAll<HTMLElement>("[data-surface]")).map(
        (el) => [el.dataset.surface ?? "", el],
      ),
    );
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    const lamp = (i: number) => lamps.get(words[i]?.dataset.word ?? "");

    let index = 0;
    let timer = 0;
    let inView = true;

    lamp(0)?.setAttribute("data-lit", "");

    function advance() {
      const leaving = words[index];
      leaving.removeAttribute("data-active");
      /* Det utgående ordet ska lämna uppåt. Utan den här flaggan
         faller det tillbaka mot sitt viloläge nedanför, och båda
         orden ser ut att röra sig åt samma håll. */
      leaving.setAttribute("data-leaving", "");
      window.setTimeout(() => leaving.removeAttribute("data-leaving"), 360);
      lamp(index)?.removeAttribute("data-lit");

      index = (index + 1) % words.length;
      words[index].setAttribute("data-active", "");
      lamp(index)?.setAttribute("data-lit", "");
    }

    function sync() {
      const run = inView && !document.hidden && !reduced.matches;
      if (run && !timer) timer = window.setInterval(advance, 2200);
      if (!run && timer) {
        window.clearInterval(timer);
        timer = 0;
      }
    }

    if (!reduced.matches) rotator.setAttribute("data-ready", "");

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          sync();
        },
        { threshold: 0 },
      ).observe(rotator);
    }

    document.addEventListener("visibilitychange", sync);
    reduced.addEventListener("change", () => {
      rotator.toggleAttribute("data-ready", !reduced.matches);
      sync();
    });

    sync();
  }
</script>
