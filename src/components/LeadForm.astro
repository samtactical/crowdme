---
import Icon from "./Icon.astro";
import Eyebrow from "./ui/Eyebrow.astro";

const branscher = [
  "SaaS / mjukvara",
  "Konsult / byrå",
  "Industri / tillverkning",
  "Bygg / fastighet",
  "Ekonomi / juridik",
  "Rekrytering / bemanning",
  "E-handel / handel",
  "Vård / hälsa",
  "Annat",
];

const labelClass = "block text-[13px] font-medium";
const hintClass = "mt-1 block text-[12px] font-normal leading-relaxed text-ink-soft";
---

<section id="boka" class="scroll-mt-24 border-b border-line">
  <div class="mx-auto grid max-w-page gap-10 px-4 py-20 sm:px-6 md:py-28 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start" data-reveal-group>
      <Eyebrow data-reveal>Steg 4 · Boka</Eyebrow>
      <h2 class="display-2 mt-8" data-reveal>Boka ett möte.</h2>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-ink-soft" data-reveal>
        Fyll i formuläret så återkommer vi med tider som passar. Ni behöver
        inte förbereda något.
      </p>

      <ul class="mt-8 space-y-0" data-reveal>
        {
          [
            "Vi går igenom hur ni syns i AI-svar idag",
            "Ni ser vilka konkurrenter som nämns istället för er",
            "Ni bestämmer själva om ni vill gå vidare",
          ].map((item) => (
            <li class="flex items-start gap-3 border-b border-line py-3 last:border-b-0">
              <span
                aria-hidden="true"
                class="mt-0.5 grid h-4 w-4 shrink-0 place-items-center rounded-pill bg-accent text-accent-ink"
              >
                <Icon name="check" weight="bold" class="h-2.5 w-2.5" />
              </span>
              <span class="text-sm leading-relaxed text-ink-soft">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="card-soft p-6 sm:p-8">
      <form id="lead-form" novalidate class="space-y-5">
        <!-- Honeypot: dolt för människor, lockande för bottar -->
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="lead-org">Organisation</label>
          <input id="lead-org" name="organisation" type="text" tabindex="-1" autocomplete="off" />
        </div>

        {/*
          Tre synliga fält. Allt annat ligger bakom "Berätta gärna mer" —
          det som avgör om någon bokar är namn, mejl och sajt. Resten är
          förberedelsematerial och får inte stå i vägen.
        */}
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="field">
            <label class={labelClass} for="namn">Ditt namn</label>
            <input
              class="field__input mt-1.5"
              id="namn"
              name="namn"
              type="text"
              required
              autocomplete="name"
              aria-describedby="namn-fel"
            />
            <span class="field__tick" aria-hidden="true">
              <Icon name="check" weight="bold" class="h-2.5 w-2.5" />
            </span>
            <p class="field__error" id="namn-fel"></p>
          </div>

          <div class="field">
            <label class={labelClass} for="epost">Jobbmejl</label>
            <input
              class="field__input mt-1.5"
              id="epost"
              name="epost"
              type="email"
              required
              autocomplete="email"
              aria-describedby="epost-fel"
            />
            <span class="field__tick" aria-hidden="true">
              <Icon name="check" weight="bold" class="h-2.5 w-2.5" />
            </span>
            <p class="field__error" id="epost-fel"></p>
          </div>
        </div>

        <div class="field">
          <label class={labelClass} for="webbplats">Er webbplats</label>
          <input
            class="field__input mt-1.5"
            id="webbplats"
            name="webbplats"
            type="text"
            required
            inputmode="url"
            placeholder="exempel.se"
            autocomplete="url"
            aria-describedby="webbplats-fel"
          />
          <span class="field__tick" aria-hidden="true">
            <Icon name="check" weight="bold" class="h-2.5 w-2.5" />
          </span>
          <p class="field__error" id="webbplats-fel"></p>
        </div>

        <details class="group rounded-md border border-line bg-paper-alt/60">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-3 text-[13px] font-medium marker:hidden">
            Berätta gärna mer
            <span class="flex items-center gap-2 text-[12px] font-normal text-ink-soft">
              Valfritt
              <span
                aria-hidden="true"
                class="grid h-5 w-5 place-items-center rounded-sm bg-paper-card text-ink-soft transition-transform duration-300 group-open:rotate-45"
              >
                <Icon name="plus" weight="bold" class="h-2.5 w-2.5" />
              </span>
            </span>
          </summary>

          <div class="space-y-4 border-t border-line px-4 pb-4 pt-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="field">
                <label class={labelClass} for="foretag">Företagsnamn</label>
                <input class="field__input mt-1.5" id="foretag" name="foretag" type="text" autocomplete="organization" />
              </div>
              <div class="field">
                <label class={labelClass} for="bransch">Bransch</label>
                <select class="field__input mt-1.5" id="bransch" name="bransch">
                  <option value="">Välj bransch</option>
                  {branscher.map((b) => <option value={b}>{b}</option>)}
                </select>
              </div>
            </div>

            <div class="field field--area">
              <label class={labelClass} for="fragor">
                Vad söker era kunder på?
                <span class={hintClass}>
                  T.ex. "bästa lönesystemet för mindre tillverkande bolag". Vi
                  använder frågorna för att förbereda mötet.
                </span>
              </label>
              <textarea class="field__input mt-1.5" id="fragor" name="fragor" rows="3"></textarea>
            </div>

            <div class="field field--area">
              <label class={labelClass} for="konkurrenter">
                Konkurrenter att jämföra med
              </label>
              <input class="field__input mt-1.5" id="konkurrenter" name="konkurrenter" type="text" />
            </div>
          </div>
        </details>

        <div class="field" data-consent>
          <div class="flex gap-2.5">
            <input
              id="samtycke"
              name="samtycke"
              type="checkbox"
              required
              class="mt-0.5 h-4 w-4 shrink-0 rounded-sm accent-[var(--color-accent-ink)]"
              aria-describedby="samtycke-fel"
            />
            <label for="samtycke" class="text-[13px] leading-relaxed text-ink-soft">
              Jag godkänner att Crowdme sparar uppgifterna för att boka mötet
              och kontakta mig om det.
            </label>
          </div>
          <p class="field__error ml-[1.625rem]" id="samtycke-fel"></p>
        </div>

        <p
          id="lead-error"
          role="alert"
          hidden
          class="rounded-md border border-warn/30 bg-warn-soft px-3.5 py-2.5 text-[13px] text-warn"
        >
        </p>

        <button
          type="submit"
          id="lead-submit"
          class="w-full rounded-md bg-solid px-5 py-3 text-sm font-medium text-ink-invert transition-colors hover:bg-solid-hover disabled:cursor-not-allowed disabled:opacity-60"
        >
          Boka möte
        </button>

        <p class="eyebrow text-center">Vi säljer aldrig vidare era uppgifter</p>
      </form>

      <!-- Tackläge -->
      <div id="lead-success" hidden class="py-10 text-center">
        <span
          class="mx-auto grid h-10 w-10 place-items-center rounded-pill bg-accent text-accent-ink"
          aria-hidden="true"
        >
          <Icon name="check" weight="bold" class="h-5 w-5" />
        </span>
        <h3 class="display-3 mt-5">Tack! Vi hör av oss.</h3>
        <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-ink-soft">
          Vi återkommer till adressen du angav med förslag på tider. Passar
          ingen av dem går det bra att svara direkt på det mejlet.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { submitLead, type Lead } from "../lib/submitLead";

  /**
   * Validering per fält, inte via reportValidity().
   *
   * Webbläsarens egna rutor visar ett fel i taget, försvinner när man
   * klickar bort och pekar inte ut vilket fält som gäller. För den som
   * fyller i det här är formuläret första kontakten — det ska kvittera
   * det som är rätt, inte bara skälla på det som är fel.
   *
   * Därför: bocken syns så fort ett fält är giltigt, felet dyker upp
   * först när man lämnat fältet, och det försvinner medan man rättar.
   */
  type Rule = { test: (v: string) => boolean; message: string };

  const rules: Record<string, Rule> = {
    namn: {
      test: (v) => v.trim().length >= 2,
      message: "Skriv ditt namn.",
    },
    epost: {
      // Medvetet tillåtande: ett @ och en punkt efter det räcker.
      test: (v) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()),
      message: "Kontrollera mejladressen.",
    },
    webbplats: {
      test: (v) => /^[^\s]+\.[^\s]{2,}$/.test(v.trim().replace(/^https?:\/\//, "")),
      message: "Skriv adressen till er sajt, t.ex. exempel.se",
    },
  };

  const form = document.querySelector<HTMLFormElement>("#lead-form");
  const success = document.querySelector<HTMLElement>("#lead-success");
  const errorBox = document.querySelector<HTMLElement>("#lead-error");
  const submitBtn = document.querySelector<HTMLButtonElement>("#lead-submit");
  const consent = document.querySelector<HTMLElement>("[data-consent]");
  const consentBox = document.querySelector<HTMLInputElement>("#samtycke");

  if (form && success && errorBox && submitBtn && consent && consentBox) {
    /** Fält som visat fel en gång validerar sedan medan man skriver. */
    const touched = new Set<string>();

    const fieldOf = (input: HTMLInputElement) =>
      input.closest<HTMLElement>(".field");

    function paint(input: HTMLInputElement, showError: boolean) {
      const rule = rules[input.name];
      const wrap = fieldOf(input);
      if (!rule || !wrap) return true;

      const valid = rule.test(input.value);
      const message = wrap.querySelector<HTMLElement>(".field__error");

      if (valid) {
        wrap.dataset.state = "ok";
        input.removeAttribute("aria-invalid");
      } else if (showError) {
        wrap.dataset.state = "error";
        input.setAttribute("aria-invalid", "true");
        if (message) message.textContent = rule.message;
      } else {
        delete wrap.dataset.state;
        input.removeAttribute("aria-invalid");
      }
      return valid;
    }

    Object.keys(rules).forEach((name) => {
      const input = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
      if (!input) return;

      // Bocken ska kvittera direkt, felet först när man lämnat fältet.
      input.addEventListener("input", () => {
        paint(input, touched.has(name));
      });
      input.addEventListener("blur", () => {
        touched.add(name);
        paint(input, true);
      });
    });

    function paintConsent(show: boolean) {
      const message = consent.querySelector<HTMLElement>(".field__error");
      if (consentBox.checked) {
        delete consent.dataset.state;
        consentBox.removeAttribute("aria-invalid");
        return true;
      }
      if (show) {
        consent.dataset.state = "error";
        consentBox.setAttribute("aria-invalid", "true");
        if (message) message.textContent = "Vi behöver ditt godkännande för att kunna höra av oss.";
      }
      return false;
    }
    consentBox.addEventListener("change", () => paintConsent(true));

    const showError = (message: string) => {
      errorBox.textContent = message;
      errorBox.hidden = false;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorBox.hidden = true;

      // Honeypot ifylld => bot. Låtsas lyckas, skicka ingenting.
      const data = new FormData(form);
      if (String(data.get("organisation") ?? "").trim() !== "") {
        form.hidden = true;
        success.hidden = false;
        return;
      }

      // Visa alla fel på en gång och hoppa till det första.
      let firstBad: HTMLElement | null = null;
      Object.keys(rules).forEach((name) => {
        const input = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
        if (!input) return;
        touched.add(name);
        if (!paint(input, true) && !firstBad) firstBad = input;
      });
      if (!paintConsent(true) && !firstBad) firstBad = consentBox;

      if (firstBad) {
        firstBad.focus({ preventScroll: true });
        firstBad.scrollIntoView({ behavior: "smooth", block: "center" });
        return;
      }

      const lead: Lead = {
        foretag: String(data.get("foretag") ?? "").trim(),
        webbplats: String(data.get("webbplats") ?? "").trim(),
        namn: String(data.get("namn") ?? "").trim(),
        epost: String(data.get("epost") ?? "").trim(),
        bransch: String(data.get("bransch") ?? ""),
        fragor: String(data.get("fragor") ?? "").trim(),
        konkurrenter: String(data.get("konkurrenter") ?? "").trim(),
      };

      submitBtn.disabled = true;
      const originalLabel = submitBtn.textContent;
      submitBtn.textContent = "Bokar…";

      try {
        await submitLead(lead);
        form.hidden = true;
        success.hidden = false;
        success.scrollIntoView({ behavior: "smooth", block: "center" });
      } catch (err) {
        console.error(err);
        showError(
          "Något gick fel när formuläret skickades. Försök igen, eller mejla oss direkt."
        );
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    });
  }
</script>
