---
import Eyebrow from "./ui/Eyebrow.astro";
const steps = [
  {
    n: "1",
    title: "Ni bokar en tid",
    body:
      "Företagsnamn, webbplats och vad era kunder brukar söka efter. Tar under två minuter.",
  },
  {
    n: "2",
    title: "Vi förbereder oss",
    body:
      "Vi sätter oss in i er bransch och era köpfrågor innan vi ses, så att samtalet handlar om er situation från första minuten.",
  },
  {
    n: "3",
    title: "Vi går igenom läget",
    body:
      "Hur ni syns i AI-svar idag, vad som påverkar det och vad som går att göra. Vill ni att vi genomför något pratar vi om det då — annars inte.",
  },
];
---

<section data-invert id="sa-gar-det-till" class="bg-paper-invert text-ink-invert">
  <div class="mx-auto max-w-page px-4 py-20 sm:px-6 md:py-28">
    <div class="max-w-2xl" data-reveal-group>
      <Eyebrow tone="invert" data-reveal>Steg 3 · Så går det till</Eyebrow>
      <h2 class="display-2 mt-8 text-ink-invert" data-reveal>
Boka en tid.<br /><span class="text-ink-invert-soft">Resten tar vi på mötet.</span>
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-ink-invert-soft" data-reveal>
        Ett samtal om hur ni syns när era köpare frågar en AI — och vad ni
        kan göra åt det.
      </p>
    </div>

    <ol class="mt-12 grid gap-3 md:mt-16 md:grid-cols-3" data-reveal-group>
      {
        steps.map((s) => (
          <li data-reveal class="card-soft-invert p-6">
            <span class="block text-4xl font-medium tracking-tight text-ink-invert-soft">
              {s.n}
            </span>
            <h3 class="mt-6 text-[1.0625rem] font-medium text-ink-invert">
              {s.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-invert-soft">
              {s.body}
            </p>
          </li>
        ))
      }
    </ol>

    <a
      href="#boka"
      class="mt-12 inline-flex items-center justify-center rounded-md bg-accent px-5 py-3 text-sm font-medium text-accent-ink transition-opacity hover:opacity-90"
    >
      Boka ett möte
    </a>
  </div>
</section>
