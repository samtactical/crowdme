---
const steps = [
  {
    n: "1",
    title: "Ni fyller i formuläret",
    body:
      "Företagsnamn, webbplats och vad era kunder brukar söka efter. Tar under två minuter.",
  },
  {
    n: "2",
    title: "Vi kör analysen",
    body:
      "Vi testar era frågor mot de stora AI-modellerna och går igenom vad på er webbplats som gör er citerbar — eller osynlig.",
  },
  {
    n: "3",
    title: "Ni får resultatet",
    body:
      "En genomgång av vad vi hittade och de åtgärder som ger mest effekt först. Vill ni att vi genomför dem pratar vi om det då — annars inte.",
  },
];
---

<section id="sa-gar-det-till" class="border-b border-line bg-paper-invert text-ink-invert">
  <div class="mx-auto max-w-6xl px-6 py-20 lg:py-24">
    <h2 class="max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">
      Så går det till
    </h2>

    <ol class="mt-14 grid gap-10 sm:grid-cols-3">
      {
        steps.map((s) => (
          <li class="border-t border-ink-invert/25 pt-6">
            <span class="font-mono text-sm tracking-widest text-ink-invert/60">
              Steg {s.n}
            </span>
            <h3 class="mt-3 text-xl font-semibold">{s.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-invert/70">{s.body}</p>
          </li>
        ))
      }
    </ol>

    <a
      href="#analys"
      class="mt-14 inline-flex items-center justify-center bg-ink-invert px-7 py-4 text-base font-semibold text-ink transition-opacity hover:opacity-90"
    >
      Starta med en gratis analys
    </a>
  </div>
</section>
