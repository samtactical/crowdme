---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import AiSearchStats from "../components/AiSearchStats.astro";
import Problem from "../components/Problem.astro";
import Analysis from "../components/Analysis.astro";
import Comparison from "../components/Comparison.astro";
import BookingCta from "../components/BookingCta.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";

const title = "Crowdme — syns ditt företag i ChatGPT och AI-sökningar?";
const description =
  "Crowdme får svenska B2B-företag att synas och citeras i ChatGPT, Perplexity, Gemini och Googles AI-svar. Boka ett möte om hur ni syns idag.";
---

<Layout title={title} description={description}>
  <Header />
  <main id="innehall" class="w-full max-w-full">
    <Hero />
    <AiSearchStats />
    <Problem />
    <Analysis />
    <Comparison />
    <Pricing />
    <Faq />
    <BookingCta />
  </main>
  <Footer />
</Layout>

<script>
  import { initMotion } from "../scripts/motion";
  initMotion();
</script>
