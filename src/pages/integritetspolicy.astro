---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// TODO INNAN LANSERING: ersätt alla [FYLL I]-fält nedan och låt någon
// juridiskt ansvarig läsa igenom. Sidan är noindex tills dess.
---

<Layout
  title="Integritetspolicy — Crowdme"
  description="Så behandlar Crowdme personuppgifter som lämnas via formuläret för AI-synlighetsanalys."
  noindex={true}
>
  <Header />
  <main id="innehall" class="mx-auto max-w-3xl px-6 py-20">
    <p class="border border-warn bg-warn-soft px-4 py-3 font-mono text-xs uppercase tracking-wider text-warn">
      Utkast — innehåller platshållare. Får inte publiceras som den är.
    </p>

    <h1 class="mt-10 text-4xl font-bold tracking-tight">Integritetspolicy</h1>

    <div class="mt-10 space-y-8 leading-relaxed text-ink-soft [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-ink">
      <section>
        <h2>Personuppgiftsansvarig</h2>
        <p class="mt-3">
          [FYLL I: juridiskt bolagsnamn], organisationsnummer [FYLL I], [FYLL I:
          adress]. Kontakt: <a class="text-accent underline" href="mailto:hej@crowdme.se">hej@crowdme.se</a>.
        </p>
      </section>

      <section>
        <h2>Vilka uppgifter vi samlar in</h2>
        <p class="mt-3">
          De uppgifter du själv fyller i i formuläret: företagsnamn, webbplats,
          namn, jobbmejl, bransch samt den fritext du väljer att lämna om era
          sökfrågor och konkurrenter.
        </p>
      </section>

      <section>
        <h2>Varför vi behandlar dem</h2>
        <p class="mt-3">
          För att kunna genomföra den kostnadsfria AI-synlighetsanalysen och
          kontakta dig med resultatet. Rättslig grund är berättigat intresse av
          att besvara en förfrågan du själv har initierat.
        </p>
      </section>

      <section>
        <h2>Hur länge vi sparar dem</h2>
        <p class="mt-3">[FYLL I: t.ex. 12 månader efter senaste kontakt, därefter radering.]</p>
      </section>

      <section>
        <h2>Vem mer får se dem</h2>
        <p class="mt-3">
          [FYLL I: lista de personuppgiftsbiträden som faktiskt används — t.ex.
          formulärtjänst, mejlutskick, CRM och webbhotell.] Vi säljer aldrig
          vidare uppgifterna.
        </p>
      </section>

      <section>
        <h2>Dina rättigheter</h2>
        <p class="mt-3">
          Du har rätt att begära utdrag, rättelse eller radering av dina
          uppgifter, samt att invända mot behandlingen. Hör av dig till adressen
          ovan. Du kan också lämna klagomål till Integritetsskyddsmyndigheten
          (IMY).
        </p>
      </section>

      <section>
        <h2>Cookies</h2>
        <p class="mt-3">
          [FYLL I när analysverktyg är på plats. Just nu sätter webbplatsen inga
          cookies och använder ingen spårning.]
        </p>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
