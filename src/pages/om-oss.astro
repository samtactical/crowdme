---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import BookingCta from "../components/BookingCta.astro";
import Footer from "../components/Footer.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";

// Texten om Samuel kommer från honom själv. Ingenting här får byggas ut
// med bakgrund, resultat eller erfarenheter som han inte har uppgett.

const title = "Om oss | Crowdme";
const description =
  "Crowdme grundades av Samuel Norström i Stockholm för att svenska företag ska synas i ChatGPT, Google AI Overviews och andra AI-svar.";

const founder = {
  name: "Samuel Norström",
  role: "Grundare",
  image: "/om-oss/samuel-norstrom.webp",
};

/** Korta fakta bredvid porträttet. Bara sådant som stämmer. */
const facts = [
  { label: "Roll", value: "Grundare av Crowdme" },
  { label: "Bas", value: "Stockholm" },
  { label: "Bakgrund", value: "SEO, AI och prompt engineering" },
];

const intro = [
  "Jag har min bakgrund i SEO och i AI. De senaste åren har tiden gått till prompt engineering och AI SEO, både för företag och i egna projekt.",
  "Det jag drivs av är den personliga servicen. Varje företag har sin egen situation, och den vill jag förstå innan jag föreslår något.",
];

/**
 * Varför Crowdme finns. Första stycket är Samuels egen anledning, resten
 * bygger på samma tes som startsidan.
 */
const story = [
  "Jag såg ett gap. Företag vill synas i AI-svaren, men vet inte hur de ska börja. Kunskapen finns hos få, och behovet hos många. Det gapet startade jag Crowdme för att fylla.",
  "Allt fler ställer sina frågor till ChatGPT, Perplexity eller Googles AI i stället för att klicka sig igenom en lista med länkar. Svaret de får nämner ett fåtal företag. Resten syns inte alls, oavsett hur bra de är på det de gör.",
  "Crowdme finns för att svenska företag ska vara med i de svaren. Inte bara de största, utan alla som har något att erbjuda.",
  "Och det ska göras personligt. Ni pratar med mig, inte med ett formulär och en rapport i mejlen.",
];

/**
 * Personen bakom Crowdme, för Google och AI-tjänster. Bara uppgifter som
 * står synligt på sidan. Kopplas till organisationen på startsidan via @id.
 */
const site = Astro.site?.href ?? "/";
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: founder.name,
  jobTitle: founder.role,
  image: new URL(founder.image, site).href,
  worksFor: { "@id": `${site}#crowdme` },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Stockholm",
    addressCountry: "SE",
  },
};
---

<Layout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <Header />
  <main id="innehall" class="w-full max-w-full">
    <section class="bg-paper">
      <div class="mx-auto max-w-page px-4 pb-20 pt-28 sm:px-6 md:pb-28 md:pt-32">
        <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
          <div class="max-w-2xl" data-reveal-group>
            <Eyebrow data-reveal>Om oss</Eyebrow>
            <h1 class="display-2 mt-8" data-reveal>
              Hej, jag heter Samuel.<br />
              <span class="text-ink-faint">Jag grundade Crowdme.</span>
            </h1>
            {intro.map((p) => (
              <p class="mt-6 text-lg leading-relaxed text-ink-soft" data-reveal>{p}</p>
            ))}

            <dl class="mt-10 grid gap-x-8 gap-y-5 border-t border-line pt-8 sm:grid-cols-3" data-reveal>
              {facts.map((fact) => (
                <div>
                  <dt class="eyebrow">{fact.label}</dt>
                  <dd class="mt-1.5 text-sm text-ink">{fact.value}</dd>
                </div>
              ))}
            </dl>
          </div>

          <figure class="mx-auto w-full max-w-md" data-reveal>
            <img
              src={founder.image}
              alt={`${founder.name}, ${founder.role.toLowerCase()} av Crowdme`}
              width="1000"
              height="1654"
              loading="eager"
              fetchpriority="high"
              class="w-full rounded-md bg-paper-alt"
            />
            <figcaption class="mt-3 text-[13px] text-ink-soft">
              {founder.name}, {founder.role.toLowerCase()}
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="varfor" class="border-y border-line bg-paper-alt">
      <div class="mx-auto max-w-page px-4 py-20 sm:px-6 md:py-28">
        <div class="max-w-2xl" data-reveal-group>
          <Eyebrow data-reveal>Varför Crowdme finns</Eyebrow>
          <h2 class="display-2 mt-8" data-reveal>
            Kunderna frågar AI nu.<br />
            <span class="text-ink-faint">Många företag syns inte i svaren.</span>
          </h2>
          {story.map((p) => (
            <p class="mt-6 text-lg leading-relaxed text-ink-soft" data-reveal>{p}</p>
          ))}
        </div>
      </div>
    </section>

    <BookingCta />
  </main>
  <Footer />
</Layout>

<script>
  import { initMotion } from "../scripts/motion";
  initMotion();
</script>
