---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import BookingCta from "../components/BookingCta.astro";
import Footer from "../components/Footer.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";

// Texten om Samuel kommer från honom själv. Ingenting här får byggas ut
// med bakgrund, resultat eller erfarenheter som han inte har uppgett.

const title = "Om oss | Crowdme";
const description =
  "Crowdme grundades av Samuel Norström i Stockholm för att svenska företag ska synas i ChatGPT, Google AI Overviews och andra AI-svar.";

const founder = {
  name: "Samuel Norström",
  role: "Grundare",
  image: "/om-oss/samuel-norstrom.webp",
};

/**
 * Citatet bär hela introduktionen. Det ligger på en mörkgrön platta i
 * stället för på en mörkgrön sektion: headern är genomskinlig innan man
 * rullar, och dess ordbild och nav är mörka. En mörk sektionsbotten
 * högst upp på sidan gör dem osynliga.
 */
const quote =
  "Hej, jag heter Samuel och jag grundade Crowdme. Jag är den du träffar på våra möten och den som ansvarar för att öka er synlighet i AI-sök.";

/** Varför Crowdme finns. Tesen är densamma som på startsidan. */
const story = [
  "Allt fler ställer sina frågor till ChatGPT, Perplexity, Googles AI och andra modeller i stället för att klicka sig igenom en lista med länkar i webbläsarens sökresultat. Svaret de får nämner ett fåtal företag. Resten syns inte, oavsett hur bra de är på det de gör.",
  "Det beror på hur AI-modellerna hämtar och värderar information. Er webbplats måste vara sökbar, begriplig och trovärdig för AI:n. Det räcker inte längre att fokusera på första sidan i Google.",
  "Crowdme ser till att kunderna hittar er i AI.",
];

/** Vad Samuel gör. Beskriver arbetet, aldrig ett resultat. */
const work = [
  "Jag arbetar dagligen med AI SEO och GEO och med att optimera webbplatsers innehåll, struktur och signaler så att AI-modeller förstår, citerar och rekommenderar er.",
  "Med en bakgrund inom hemsidor och UX har jag ett praktiskt perspektiv: jag vet hur AI-modeller svarar, vilken information de föredrar, och hur jag vänder det till konkret synlighet för svenska företag.",
];

const now = [
  "AI-sökning är fortfarande nytt. Det innebär att det finns en tydlig fördel i att vara tidig. De företag som börjar med AI SEO idag bygger ett försprång som blir svårare att hinna ikapp senare. Men det kräver löpande, kvalitativt arbete. Crowdme erbjuder exakt det.",
  "Crowdme startades för att fylla det gapet: att svenska företag ska dyka upp i svaren där deras kunder aktivt ställer frågor.",
];

/** Grundprinciperna. Löften, inte meriter — se README. */
const principles = [
  {
    title: "Personligt",
    body: "Ni får personlig service, från start till slut.",
  },
  {
    title: "Effektivt",
    body: "Den här branschen kräver att man är snabb och justerar taktiken när ytorna ändrar sig. Det sköter vi.",
  },
  {
    title: "Professionellt",
    body: "Vi garanterar ett professionellt utfört arbete, för er, era leverantörer och alla inblandade.",
  },
];

/**
 * Personen bakom Crowdme, för Google och AI-tjänster. Bara uppgifter som
 * står synligt på sidan. Kopplas till organisationen på startsidan via @id.
 */
const site = Astro.site?.href ?? "/";
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: founder.name,
  jobTitle: founder.role,
  image: new URL(founder.image, site).href,
  worksFor: { "@id": `${site}#crowdme` },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Stockholm",
    addressCountry: "SE",
  },
};
---

<Layout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <Header />
  <main id="innehall" class="w-full max-w-full">
    <section class="bg-paper">
      <div class="mx-auto max-w-page px-4 pb-20 pt-28 sm:px-6 md:pb-28 md:pt-32">
        <div data-reveal-group>
          <Eyebrow data-reveal>Om Crowdme</Eyebrow>

          <div class="mt-8 grid gap-6 lg:grid-cols-[1.35fr_0.65fr] lg:items-stretch">
            <figure
              data-invert
              class="relative flex flex-col justify-center rounded-md bg-paper-invert p-8 text-ink-invert md:p-12 lg:min-h-[26rem]"
              data-reveal
            >
              {/* Citattecknet är ett tecken, inte en bild: det skalar med
                  typsnittet och kostar ingen begäran. Limen bär det mot
                  mörkgrönt, där den har kontrast. */}
              <span
                aria-hidden="true"
                class="block text-[5rem] leading-[0.5] text-accent md:text-[7rem]"
              >
                &ldquo;
              </span>

              <blockquote class="mt-4">
                <h1 class="display-3 text-balance text-ink-invert">{quote}</h1>
              </blockquote>

              <figcaption class="mt-8 flex items-center gap-3 text-sm text-ink-invert-soft">
                <img
                  src="/logo/crowdme-icon-lime.webp"
                  alt=""
                  width="471"
                  height="516"
                  class="h-4 w-auto"
                />
                {founder.name}, {founder.role.toLowerCase()} av Crowdme
              </figcaption>
            </figure>

            {/* Originalet är 1000x1654. Bilden ligger absolut i rutan, annars
                sätter dess egen höjd radens höjd och citatplattan sträcks
                till en tom pelare bredvid. I mobil bär rutan 4:5, i desktop
                följer den citatets höjd. Filen rörs inte. */}
            <div
              class="relative aspect-[5/4] overflow-hidden rounded-md bg-paper-alt sm:aspect-[16/9] lg:aspect-auto"
              data-reveal
            >
              <img
                src={founder.image}
                alt={`${founder.name}, ${founder.role.toLowerCase()} av Crowdme`}
                width="1000"
                height="1654"
                loading="eager"
                fetchpriority="high"
                class="absolute inset-0 h-full w-full object-cover object-[50%_58%] lg:object-[50%_32%]"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="varfor" class="border-t border-line bg-paper-alt">
      <div class="mx-auto max-w-page px-4 py-20 sm:px-6 md:py-28">
        <div class="max-w-2xl" data-reveal-group>
          <Eyebrow data-reveal>Varför Crowdme finns</Eyebrow>
          <h2 class="display-2 mt-8" data-reveal>
            Kunderna frågar AI nu.<br />
            <span class="text-ink-faint">Många företag saknas i svaren.</span>
          </h2>
          {story.map((p) => (
            <p class="mt-6 text-lg leading-relaxed text-ink-soft" data-reveal>{p}</p>
          ))}
        </div>
      </div>
    </section>

    <section id="vad-jag-gor" class="border-t border-line bg-paper">
      <div class="mx-auto max-w-page px-4 py-20 sm:px-6 md:py-28">
        <div class="max-w-2xl" data-reveal-group>
          <Eyebrow data-reveal>Vad jag gör</Eyebrow>
          <h2 class="display-2 mt-8" data-reveal>
            Innehåll, struktur och signaler.<br />
            <span class="text-ink-faint">Det AI-modellerna går på.</span>
          </h2>
          {work.map((p) => (
            <p class="mt-6 text-lg leading-relaxed text-ink-soft" data-reveal>{p}</p>
          ))}
        </div>

        <div class="mt-12 grid gap-3 md:mt-16 md:grid-cols-3" data-reveal-group>
          {principles.map((item) => (
            <article class="card-soft rounded-md p-6" data-reveal>
              <h3 class="text-[1.0625rem] font-medium">{item.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="varfor-nu" class="border-t border-line bg-paper-alt">
      <div class="mx-auto max-w-page px-4 py-20 sm:px-6 md:py-28">
        <div class="max-w-2xl" data-reveal-group>
          <Eyebrow data-reveal>Varför nu</Eyebrow>
          <h2 class="display-2 mt-8" data-reveal>
            Försprånget byggs idag.<br />
            <span class="text-ink-faint">Det hinns inte ikapp i efterhand.</span>
          </h2>
          {now.map((p) => (
            <p class="mt-6 text-lg leading-relaxed text-ink-soft" data-reveal>{p}</p>
          ))}
        </div>
      </div>
    </section>

    <BookingCta />
  </main>
  <Footer />
</Layout>

<script>
  import { initMotion } from "../scripts/motion";
  initMotion();
</script>
