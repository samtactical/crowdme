---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import BookingCta from "../components/BookingCta.astro";
import Footer from "../components/Footer.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";

// Texten om Samuel kommer från honom själv. Ingenting här får byggas ut
// med bakgrund, resultat eller erfarenheter som han inte har uppgett.

const title = "Om oss | Crowdme";
const description =
  "Crowdme grundades av Samuel Norström i Stockholm för att svenska företag ska synas i ChatGPT, Google AI Overviews och andra AI-svar.";

const founder = {
  name: "Samuel Norström",
  role: "Grundare",
  image: "/om-oss/samuel-norstrom.webp",
};

const intro = [
  "Jag är personen bakom Crowdme. Det är mig ni träffar på mötet, och det är jag som ansvarar för att öka er synlighet i AI.",
  "AI-sökning är nytt, och det är just därför det är läge att hoppa på tåget nu. Jag har lagt min tid på att lära mig AI SEO och GEO på djupet, och med en bakgrund inom hemsidor och UX kommer jag med ett unikt perspektiv. Jag har provat, testat och förstår hur AI-modellerna svarar. I de svaren ser jag till att ni syns.",
];

/**
 * Varför Crowdme finns. Gapet är Samuels egen anledning, resten bygger på
 * samma tes som startsidan.
 */
const story = [
  "Allt fler ställer sina frågor till ChatGPT, Perplexity, Googles AI eller någon annan modell i stället för att klicka sig igenom den lista med länkar vi är vana vid. Svaret de får nämner ett fåtal företag. Resten syns inte alls, oavsett hur bra de är på det de gör.",
  "Det beror på hur AI-modellerna hämtar sin information. Er information måste vara ordentligt sökbar för dem. Det räcker inte längre att ligga på första sidan i Google.",
  "Många företag tänker inte på att det här kostar dem kunder. Vi ser till att kunderna hittar er i stället.",
  "Crowdme startades för att fylla det gapet. För att svenska företag ska vara med i svaren, inte bara de största, utan alla som har något att erbjuda. Där ska ni synas.",
  "Att området är nytt är det bästa med att arbeta med Crowdme. Det är bra att vara tidig i en AI-värld som växer snabbt.",
];

/** Grundprinciperna. Löften, inte meriter — se README. */
const principles = [
  {
    title: "Personligt",
    body: "Ni får personlig service, från start till slut.",
  },
  {
    title: "Effektivt",
    body: "Den här branschen kräver att man är snabb och justerar taktiken när ytorna ändrar sig. Det sköter vi.",
  },
  {
    title: "Professionellt",
    body: "Vi garanterar ett professionellt utfört arbete, för er, era leverantörer och alla inblandade.",
  },
];

/**
 * Personen bakom Crowdme, för Google och AI-tjänster. Bara uppgifter som
 * står synligt på sidan. Kopplas till organisationen på startsidan via @id.
 */
const site = Astro.site?.href ?? "/";
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: founder.name,
  jobTitle: founder.role,
  image: new URL(founder.image, site).href,
  worksFor: { "@id": `${site}#crowdme` },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Stockholm",
    addressCountry: "SE",
  },
};
---

<Layout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <Header />
  <main id="innehall" class="w-full max-w-full">
    <section class="bg-paper">
      <div class="mx-auto max-w-page px-4 pb-20 pt-28 sm:px-6 md:pb-28 md:pt-32">
        <div class="grid items-center gap-12 lg:grid-cols-[1fr_auto] lg:gap-20">
          <div class="max-w-2xl" data-reveal-group>
            <Eyebrow data-reveal>Om oss</Eyebrow>
            <h1 class="display-2 mt-8" data-reveal>
              Hej, jag heter Samuel.<br />
              <span class="text-ink-faint">Jag grundade Crowdme.</span>
            </h1>
            {intro.map((p) => (
              <p class="mt-6 text-lg leading-relaxed text-ink-soft" data-reveal>{p}</p>
            ))}
          </div>

          {/* Originalet är 1000x1654 och blir en smal remsa bredvid texten,
              särskilt i mobil. Beskärningen görs i CSS: 4:5-ruta och
              object-position 88% så att ansiktet hamnar högt och de korsade
              armarna får vara kvar. Filen rörs inte. */}
          <figure class="mx-auto w-full max-w-sm" data-reveal>
            <img
              src={founder.image}
              alt={`${founder.name}, ${founder.role.toLowerCase()} av Crowdme`}
              width="1000"
              height="1654"
              loading="eager"
              fetchpriority="high"
              class="aspect-[4/5] w-full rounded-md bg-paper-alt object-cover object-[50%_88%]"
            />
            <figcaption class="mt-3 text-[13px] text-ink-soft">
              {founder.name}, {founder.role.toLowerCase()}
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="varfor" class="border-t border-line bg-paper-alt">
      <div class="mx-auto max-w-page px-4 py-20 sm:px-6 md:py-28">
        <div class="max-w-2xl" data-reveal-group>
          <Eyebrow data-reveal>Varför Crowdme startades</Eyebrow>
          <h2 class="display-2 mt-8" data-reveal>
            Kunderna frågar AI nu.<br />
            <span class="text-ink-faint">Många företag saknas i svaren.</span>
          </h2>
          {story.map((p) => (
            <p class="mt-6 text-lg leading-relaxed text-ink-soft" data-reveal>{p}</p>
          ))}
        </div>
      </div>
    </section>

    <section id="sa-arbetar-jag" class="border-y border-line bg-paper">
      <div class="mx-auto max-w-page px-4 py-20 sm:px-6 md:py-28">
        <div class="max-w-2xl" data-reveal-group>
          <Eyebrow data-reveal>Våra grundprinciper</Eyebrow>
          <h2 class="display-2 mt-8" data-reveal>
            Tre saker ni kan räkna med.
          </h2>
        </div>

        <div class="mt-12 grid gap-3 md:mt-16 md:grid-cols-3" data-reveal-group>
          {principles.map((item) => (
            <article class="card-soft rounded-md p-6" data-reveal>
              <h3 class="text-[1.0625rem] font-medium">{item.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <BookingCta />
  </main>
  <Footer />
</Layout>

<script>
  import { initMotion } from "../scripts/motion";
  initMotion();
</script>
